# ---------------------------------------------------------------------------
# Backend environment. Copy to backend/.env and fill in.
# Every value here is a placeholder — there are no real secrets in this file.
# ---------------------------------------------------------------------------

# --- Database (matches the root docker-compose.yml) ------------------------
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- JWT --------------------------------------------------------------------
# Generate real values with: openssl rand -base64 48
# Access and refresh secrets MUST be different.
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=changeme-too
JWT_REFRESH_TTL=7d

# --- Password reset + login rate limiting (SCRUM-43) -----------------------
# TTL for a password-reset token. Accepts s/m/h/d suffixes.
PASSWORD_RESET_TTL=1h
# Max POST /auth/login and POST /auth/forgot-password attempts per window.
AUTH_RATE_LIMIT_LOGIN=10
# Throttler window, in seconds.
AUTH_RATE_LIMIT_TTL=60

# --- Mail (SCRUM-43) ------------------------------------------------------
MAIL_FROM="Customer Support CRM <no-reply@example.com>"
# Leave SMTP_URL unset in development: MailService logs the reset link instead.
#   SMTP_URL=smtp://user:pass@smtp.example.com:587
# Base URL of the web app, used to build the link in the reset email.
FRONTEND_BASE=http://localhost:3000

# --- Object storage (S3-compatible: Cloudflare R2 or Supabase Storage) ------
# Do NOT use local disk (files are lost on redeploy) and do NOT self-host MinIO.
#   R2:       https://<account-id>.r2.cloudflarestorage.com   (S3_REGION=auto)
#   Supabase: https://<project-ref>.supabase.co/storage/v1/s3
# Leave these at their placeholder values to run without storage; the storage
# e2e test skips itself when credentials are absent.
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=crm-attachments
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme

# --- Local seed account (development smoke tests only) ----------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme
